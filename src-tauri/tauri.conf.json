{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portfolio",
  "version": "0.1.3",
  "identifier": "app.portfolio.local",
  "build": {"beforeDevCommand":"npm run dev","devUrl":"http://127.0.0.1:1420","beforeBuildCommand":"npm run build","frontendDist":"../dist"},
  "app": {
    "windows": [{"label":"main","title":"Portfolio","width":1280,"height":800,"minWidth":1000,"minHeight":700,"center":true,"titleBarStyle":"Overlay","hiddenTitle":true,"dragDropEnabled":false,"trafficLightPosition":{"x":18,"y":20}}],
    "security":{"csp":"default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.elbstream.com; connect-src ipc: http://ipc.localhost"}
  },
  "bundle":{"active":true,"targets":["app"],"icon":["icons/icon.png","icons/icon.icns"],"macOS":{"minimumSystemVersion":"11.0"}}
}
